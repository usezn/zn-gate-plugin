{
  "description": "zn-gate: keep secret values out of tool calls, tool output and prompts. Every hook runs the pinned, verified zn-gate package through scripts/zn-launch.js.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "shell": "bash", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/zn-node.sh\" SessionStart check claude-code", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Monitor|Read|Grep|LSP|Edit|MultiEdit|Write|NotebookEdit|WebFetch)$|^mcp__.*",
        "hooks": [
          { "type": "command", "shell": "bash", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/zn-node.sh\" PreToolUse hook claude-code", "timeout": 15, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Monitor|Read|Grep|LSP|WebFetch|ReadMcpResourceTool)$|^mcp__.*",
        "hooks": [
          { "type": "command", "shell": "bash", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/zn-node.sh\" PostToolUse hook claude-code", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "shell": "bash", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/zn-node.sh\" UserPromptSubmit hook claude-code", "timeout": 15, "onFailure": "block" }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "shell": "bash", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/zn-node.sh\" UserPromptExpansion hook claude-code", "timeout": 15, "onFailure": "block" }
        ]
      }
    ]
  }
}
